{
  "manifest_version": 3,
  "name": "JD WebUI Click'n'Load",
  "version": "1.2.0",
  "description": "Leitet Click'n'Load von Download-Seiten an deine JD WebUI im Heimnetz weiter.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JD WebUI Click'n'Load",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "cnl/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cnl",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  }
}
